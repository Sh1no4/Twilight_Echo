# Maintainer: Bad0RANG3 <bad0rang3@users.noreply.github.com>
# Contributor: Bad0RANG3 <bad0rang3@users.noreply.github.com>
pkgname=twilight-echo
pkgver=1.0.2
pkgrel=1
pkgdesc='Local and streaming music player with synchronized/word-level lyrics and DSP'
arch=('x86_64')
url='https://github.com/asenyarzc-cpu/Twilight_Echo'
license=('Apache-2.0')
depends=(
  'alsa-lib' 'bzip2' 'ffmpeg' 'gcc-libs' 'glibc' 'gmp' 'gnutls' 'gtk3'
  'lcms2' 'at-spi2-core' 'libbluray' 'libdvdnav' 'libdvdread' 'libebur128'
  'libmodplug' 'libnotify' 'libopenmpt' 'libsecret' 'libssh' 'libvpx'
  'libwebp' 'libxml2' 'libxss' 'libxtst' 'nss' 'srt' 'util-linux' 'xz'
  'zeromq' 'zlib'
)
provides=("${pkgname}")
conflicts=("${pkgname}")
source=("https://github.com/asenyarzc-cpu/Twilight_Echo/releases/download/v${pkgver}/TwilightEcho-${pkgver}.tar.gz")
sha256sums=('f7d46569d5aa4c7096e6a8246274142e4172ac1ecb13ef276df4b64e686f6c50')

package() {
  install -d "$pkgdir/opt/TwilightEcho"
  cp -a "$srcdir/TwilightEcho-${pkgver}/." "$pkgdir/opt/TwilightEcho/"
  # Electron sandbox helper must be setuid root inside the package.
  # pacman installs package files as root:root, so only the setuid bit is set here.
  chmod 4755 "$pkgdir/opt/TwilightEcho/chrome-sandbox"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/TwilightEcho/twilightecho "$pkgdir/usr/bin/twilight-echo"

  install -Dm644 "$srcdir/TwilightEcho-${pkgver}/resources/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/twilight-echo.png"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/twilight-echo.desktop" <<'DEOF'
[Desktop Entry]
Name=Twilight Echo
Name[zh_CN]=暮光回声
Comment=Local and streaming music player with lyrics and DSP
Exec=/opt/TwilightEcho/twilightecho %U
Icon=twilight-echo
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;
StartupWMClass=TwilightEcho
DEOF
}
