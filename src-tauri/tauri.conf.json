{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twilight Echo",
  "version": "1.0.5",
  "identifier": "com.twilightecho.app",
  "build": {
    "beforeDevCommand": "pnpm run build:plugin-host && pnpm run build:audio-engine:node && pnpm run build:ncm-gateway && pnpm run stage:node-runtime",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm run build:web && pnpm run build:plugin-host && pnpm run build:audio-engine:node && pnpm run build:ncm-gateway && pnpm run stage:node-runtime",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: cover: background: theme-asset: twilight-media: https:; media-src 'self' blob: asset: data: https:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:3100 http://127.0.0.1:3101 https:; font-src 'self' data: asset:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Twilight Echo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true
      },
      {
        "label": "mini-player",
        "title": "Twilight Echo Mini Player",
        "url": "index.html?window=mini-player",
        "width": 480,
        "height": 300,
        "minWidth": 420,
        "minHeight": 220,
        "maxWidth": 900,
        "maxHeight": 520,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "tray-player",
        "title": "Twilight Echo Tray Player",
        "url": "index.html?window=tray-player",
        "width": 360,
        "height": 176,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "desktop-lyrics",
        "title": "Twilight Echo 桌面歌词",
        "url": "desktop-lyrics.html",
        "width": 900,
        "height": 160,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/plugins/ncm-provider": "plugins/ncm-provider",
      "../resources/plugin-index": "plugin-index",
      "../out/plugin-host/pluginHostNode.js": "sidecar/pluginHostNode.js",
      "../out/audio-engine/audioEngineNode.js": "sidecar/audioEngineNode.js",
      "../out/ncm-gateway/ncmGateway.js": "sidecar/ncmGateway.js",
      "../out/data/china_ip_ranges.txt": "data/china_ip_ranges.txt",
      "../out/data/deviceid.txt": "data/deviceid.txt",
      "../resources/sidecar/node.exe": "sidecar/node.exe",
      "../resources/audio-engine/twilight-audio-engine.dll": "audio-engine/twilight-audio-engine.dll",
      "../resources/audio-engine/twilight_audio_node.node": "audio-engine/twilight_audio_node.node"
    }
  }
}
