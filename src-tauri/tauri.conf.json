{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twilight Echo",
  "version": "1.0.5",
  "identifier": "com.twilightecho.app",
  "build": {
    "beforeDevCommand": "pnpm vite --config vite.config.ts",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm run build:web",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Twilight Echo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/plugins/ncm-provider": "plugins/ncm-provider",
      "../resources/plugin-index": "plugin-index"
    }
  }
}
