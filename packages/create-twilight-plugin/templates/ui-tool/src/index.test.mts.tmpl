import assert from 'node:assert/strict'
import test from 'node:test'
import { activate } from './index.mjs'

test('registers controlled UI', async () => {
  let commandRegistered = false
  let uiRegistered = false
  await activate({
    apiVersion: 1,
    storagePath: '',
    settings: {
      get: async () => undefined,
      set: async () => undefined,
      delete: async () => undefined
    },
    logger: {
      debug: () => undefined,
      info: () => undefined,
      warn: () => undefined,
      error: () => undefined
    },
    twilight: {
      events: {} as never,
      player: {} as never,
      providers: {} as never,
      ui: {
        onCommand: () => {
          commandRegistered = true
        },
        register: async () => {
          uiRegistered = true
        }
      },
      themes: {} as never
    }
  })
  assert.equal(commandRegistered, true)
  assert.equal(uiRegistered, true)
})
