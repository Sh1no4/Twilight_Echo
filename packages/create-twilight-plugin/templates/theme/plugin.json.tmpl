{
  "id": "{{pluginId}}",
  "name": "{{pluginName}}",
  "version": "1.0.0",
  "description": "{{pluginDescription}}",
  "author": "Example Author",
  "license": "Apache-2.0",
  "type": ["theme"],
  "engines": {
    "twilightEcho": ">=0.20.0"
  },
  "apiVersion": 3,
  "permissions": [],
  "contributes": {
    "themes": [
      {
        "id": "{{packageName}}",
        "name": "{{pluginName}}",
        "description": "A declarative Twilight Echo theme.",
        "variables": {
          "--te-primary-500": "#2563eb",
          "--te-success-500": "#16a34a"
        },
        "structured": {
          "schemaVersion": 3,
          "variants": {
            "pureWhite": {
              "tokens": {
                "color.primary.500": "#2563eb"
              }
            },
            "dark": {
              "tokens": {
                "color.primary.500": "#60a5fa"
              }
            }
          },
          "modes": {
            "navigation": {
              "style": "compact"
            },
            "library": {
              "density": "compact",
              "selection": "stroke"
            },
            "player": {
              "layout": "split",
              "controls": "pro"
            },
            "icons": {
              "family": "rounded"
            },
            "visibility": {
              "playerWaveform": false
            }
          },
          "layout": {
            "desktop": {
              "columns": ["standard", "fill"],
              "rows": ["auto", "fill", "auto"],
              "areas": [
                ["titleBar", "titleBar"],
                ["navigation", "content"],
                ["navigation", "playerBar"]
              ]
            },
            "compact": {
              "columns": ["fill"],
              "rows": ["auto", "fill", "auto"],
              "areas": [["titleBar"], ["content"], ["playerBar"]]
            },
            "navigation": "persistent"
          }
        },
        "stylesheet": "theme.css"
      }
    ]
  }
}
