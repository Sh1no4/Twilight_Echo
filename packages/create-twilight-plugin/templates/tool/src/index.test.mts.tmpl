import assert from 'node:assert/strict'
import test from 'node:test'
import { activate, deactivate } from './index.mjs'

test('activates and deactivates', async () => {
  let subscribed = false
  let unsubscribed = false
  await activate({
    apiVersion: 1,
    storagePath: '',
    settings: {
      get: async () => undefined,
      set: async () => undefined,
      delete: async () => undefined
    },
    logger: {
      debug: () => undefined,
      info: () => undefined,
      warn: () => undefined,
      error: () => undefined
    },
    twilight: {
      events: {
        on: () => {
          subscribed = true
          return () => {
            unsubscribed = true
          }
        }
      },
      player: {} as never,
      providers: {} as never,
      ui: {} as never,
      themes: {} as never
    }
  })
  await deactivate()
  assert.equal(subscribed, true)
  assert.equal(unsubscribed, true)
})
