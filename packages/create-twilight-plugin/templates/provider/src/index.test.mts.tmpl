import assert from 'node:assert/strict'
import test from 'node:test'
import { activate } from './index.mjs'

test('registers provider', async () => {
  let registered = false
  await activate({
    apiVersion: 1,
    storagePath: '',
    settings: {
      get: async () => undefined,
      set: async () => undefined,
      delete: async () => undefined
    },
    logger: {
      debug: () => undefined,
      info: () => undefined,
      warn: () => undefined,
      error: () => undefined
    },
    twilight: {
      events: {} as never,
      player: {} as never,
      providers: {
        register: async (provider) => {
          registered = provider.capabilities.includes('search')
        }
      },
      ui: {} as never,
      themes: {} as never
    }
  })
  assert.equal(registered, true)
})
